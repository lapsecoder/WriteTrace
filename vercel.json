{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "fastapi",

  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",

  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{docs/**,tests/**,scripts/**,logs/**,frontend/src/**,frontend/node_modules/**,frontend/.astro/**,ml/models/segments-v1/**,ml/models/baseline-v1/**,**/__pycache__/**,**/*.pyc,**/.pytest_cache/**}"
    }
  },

  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}