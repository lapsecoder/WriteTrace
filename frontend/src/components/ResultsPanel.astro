---
/**
 * Results panel — the editorial "reading" of one analysis.
 *
 * Every value rendered here comes from `AnalyzeResponse`. Nothing is computed,
 * inferred or embellished client-side; when the backend abstains, this panel
 * says so instead of showing a verdict.
 */
import type { AnalyzeResponse } from "../lib/types";
import {
  DECISION_COPY,
  formatBand,
  formatCount,
  formatInterval,
  formatProbability,
  labelCopy,
} from "../lib/format";
import { isAbstention } from "../lib/render-result";
import ProbabilityBar from "./ProbabilityBar.astro";
import SignalList from "./SignalList.astro";

interface Props {
  result: AnalyzeResponse;
}

const { result } = Astro.props;
const copy = labelCopy(result.label);
const abstained = isAbstention(result);
const mixed = result.mixed_low_confidence;
const band = result.gate.mixed_band;

const pct = (v: number) =>
  Number.isFinite(v) ? `${(Math.max(0, Math.min(1, v)) * 100).toFixed(1)}%` : "n/a";
---

<article
  class="sheet sheet--raised grain animate-rise p-6 sm:p-9"
  data-testid="results"
  aria-labelledby="result-headline"
>
  <header class="flex flex-wrap items-start justify-between gap-6">
    <div class="min-w-0">
      <p class="micro">reading</p>
      <h2
        id="result-headline"
        class="mt-2 font-display text-[2rem] leading-tight text-balance"
        data-testid="result-label"
        data-abstained={abstained ? "true" : "false"}
      >
        {copy.headline}
      </h2>
      <p class="mt-3 max-w-prose text-[1.0625rem] leading-relaxed text-ink-soft text-pretty">
        {copy.gloss}
      </p>
    </div>

    <span
      class={`stamp shrink-0 ${abstained ? "animate-stamp text-graphite" : mixed ? "animate-stamp" : "animate-stamp text-ink-soft"}`}
      data-testid="decision-stamp"
    >
      {abstained ? "no verdict" : mixed ? "uncertain" : "assessed"}
    </span>
  </header>

  {
    abstained && (
      <aside
        class="annotation mt-7"
        data-testid="insufficient-evidence"
        role="note"
      >
        <p class="micro micro--ink">insufficient evidence</p>
        <p class="mt-1.5 text-[0.9375rem] leading-relaxed">
          This text has {formatCount(result.word_count)}{" "}
          {result.word_count === 1 ? "word" : "words"}, below the{" "}
          {formatInterval(result.gate.min_words)} evidence threshold selected
          during model validation. The model is reporting the probability below
          for transparency only — it is not offering a human or machine
          classification, and no confidence is attached.
        </p>
      </aside>
    )
  }

  {
    mixed && !abstained && (
      <aside class="annotation mt-7" data-testid="mixed-note" role="note">
        <p class="micro micro--ink">mixed band</p>
        <p class="mt-1.5 text-[0.9375rem] leading-relaxed">
          The estimate of {formatProbability(result.machine_probability)} sits
          inside the model's mixed band ({formatBand(band)}), where validation
          accuracy was close to a coin flip. Treat this reading as undecided
          rather than as evidence either way.
        </p>
      </aside>
    )
  }

  <div class="mt-8 grid gap-8 border-t border-rule pt-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <section
      aria-label={abstained
        ? "Raw model output (not interpretable)"
        : "Probability estimate"}
    >
      {
        abstained ? (
          <div class="w-full" data-testid="raw-estimate">
            <p class="micro">raw model output · not interpretable</p>
            <p
              class="mt-1.5 font-display text-[1.75rem] tabular-nums text-graphite"
              data-testid="raw-machine-output"
            >
              {pct(result.machine_probability)}
            </p>
            <p class="mt-2 max-w-prose text-[0.8125rem] leading-relaxed text-graphite">
              This is the model&rsquo;s raw machine-likeness score, reported
              unchanged for transparency. For an input this short it is not
              reliable enough to interpret: it is not the probability that the
              text was machine-generated, and no human-versus-machine comparison
              is offered here.
            </p>
          </div>
        ) : (
          <ProbabilityBar
            machine={result.machine_probability}
            human={result.human_probability}
            tone={copy.tone}
          />
        )
      }

      <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
        <div>
          <dt class="micro">decision</dt>
          <dd class="mt-1 text-[0.9375rem]" data-testid="decision">
            {
              abstained
                ? "No verdict — abstained (below the evidence threshold)"
                : (DECISION_COPY[result.decision] ?? result.decision)
            }
          </dd>
        </div>
        <div>
          <dt class="micro">confidence</dt>
          <dd class="mt-1 text-[0.9375rem]" data-testid="confidence">
            {
              result.confidence === null
                ? "not reported (insufficient evidence)"
                : formatProbability(result.confidence)
            }
          </dd>
        </div>
        <div>
          <dt class="micro">words</dt>
          <dd class="mt-1 text-[0.9375rem] tabular-nums" data-testid="word-count">
            {formatCount(result.word_count)}
          </dd>
        </div>
        <div>
          <dt class="micro">characters</dt>
          <dd class="mt-1 text-[0.9375rem] tabular-nums">
            {formatCount(result.text_length.characters)}
          </dd>
        </div>
        <div>
          <dt class="micro">sentences</dt>
          <dd class="mt-1 text-[0.9375rem] tabular-nums">
            {formatCount(result.text_length.sentences)}
          </dd>
        </div>
        <div>
          <dt class="micro">paragraphs</dt>
          <dd class="mt-1 text-[0.9375rem] tabular-nums">
            {formatCount(result.text_length.paragraphs)}
          </dd>
        </div>
      </dl>

      {
        result.confidence !== null && (
          <p class="mt-5 text-[0.8125rem] leading-relaxed text-graphite">
            Confidence here is the leading class probability, rounded for
            display — it is not a separately trained confidence model.
          </p>
        )
      }
    </section>

    <aside class="lg:border-l lg:border-rule lg:pl-8">
      <h3 class="micro">provenance</h3>
      <dl class="mt-3 space-y-2 text-[0.875rem]">
        <div class="flex justify-between gap-4">
          <dt class="text-graphite">model</dt>
          <dd class="font-mono" data-testid="model-name">{result.model_name}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-graphite">version</dt>
          <dd class="font-mono" data-testid="model-version">
            {result.model_version}
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-graphite">calibration</dt>
          <dd class="font-mono">{result.calibrator}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-graphite">threshold</dt>
          <dd class="font-mono tabular-nums">{result.threshold}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-graphite">evidence gate</dt>
          <dd class="font-mono">{formatInterval(result.gate.min_words)}</dd>
        </div>
      </dl>

      {
        result.warnings.length > 0 && (
          <div class="mt-7" data-testid="warnings">
            <h3 class="micro">annotations</h3>
            <ul class="mt-3 space-y-3">
              {result.warnings.map((w) => (
                <li class="annotation text-[0.875rem] leading-relaxed">
                  {w}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="mt-7 text-[0.8125rem] italic leading-relaxed text-graphite">
        {result.disclaimer}
      </p>
    </aside>
  </div>

  <section class="mt-9 border-t border-rule pt-8" aria-label="Stylistic signals">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h3 class="micro">stylistic signals</h3>
      <p class="micro text-graphite/80">
        statistical evidence · not proof of authorship
      </p>
    </div>
    <div class="mt-5">
      <SignalList signals={result.signals} />
    </div>
  </section>

  <p class="sr-only" data-testid="segment-note">
    Paragraph-level analysis is intentionally not shown: Phase 5A found segment
    scores unreliable outside the training distribution.
  </p>
</article>