    "hgb_learning_rate_grid": [0.06, 0.1],
    "hgb_max_leaf_nodes_grid": [31, 63],
    "hgb_max_iter": 300
  },
  "feature_version": "features_v1",
  "run_name": "baseline-v1",
  "selection_metric": "pr_auc_val_tune",
  "notes": "Phase 1 config. MAGE only for train/val/test. HC3 is eval-only. RAID is eval-only and never trained on. Seeds recorded in run manifests."
