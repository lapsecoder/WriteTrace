{
 "pipeline_version": "phase5a_segments_v1",
 "seed": 42,
 "train_docs": 60000,
 "val_tune_docs": 12000,
 "val_cal_docs": 12000,
 "policy": {
  "max_segment_words": 150,
  "min_window_words": 30,
  "heading_max_words": 12,
  "merge_headings": true
 },
 "candidates": {
  "hgb_seg": {
   "type": "hist_gradient_boosting",
   "learning_rate": 0.1,
   "max_leaf_nodes": 63,
   "max_iter": 300,
   "random_state": 42
  },
  "lr_seg": {
   "type": "logistic_regression",
   "C_grid": [0.1, 1.0, 10.0]
  }
 },
 "calibrators": [
  "platt",
  "isotonic"
 ],
 "selection_order": [
  "ood_auc_mean",
  "calibration_brier",
  "false_positive_behavior",
  "pr_auc",
  "in_distribution_performance"
 ],
 "tie_bands": {
  "ood_auc_mean": 0.02,
  "calibration_brier": 0.005,
  "false_positive_behavior": 0.01,
  "pr_auc": 0.005
 },
 "tie_band_note": "Mirrors the Phase-3 lexicographic protocol: a criterion only decides the winner when the next criterion is not within its tie band, so noise-level robustness differences cannot hijack selection.",
 "composite": {
  "target_words": 110,
  "n_composites": 800,
  "min_source_words": 60,
  "max_source_words": 150
 },
 "raid_attacks": [
  "none",
  "paraphrase",
  "insert_paragraphs",
  "synonym",
  "article_deletion",
  "whitespace",
  "homoglyph",
  "upper_lower",
  "number"
 ],
 "gate_candidates": [30, 40, 50, 60, 80, 100, 120, 150],
 "workers": 4,
 "config_path": "ml/configs/phase5a_segments.json"
}
